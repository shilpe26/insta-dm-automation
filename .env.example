# "unified" (default) = Instagram API with Unified Login (graph.facebook.com, system-user token)
# "instagram_login"   = older Instagram API with Instagram Login (graph.instagram.com, IGAA... token)
API_MODE=unified

# ---- Meta app (developers.facebook.com -> your app)
APP_SECRET=                    # App settings > Basic > App secret. Used to verify webhook signatures.
                               # (INSTAGRAM_APP_SECRET is still accepted as an old name.)
IG_ACCESS_TOKEN=               # Unified: system-user token generated in "API setup with Unified login".
                               # instagram_login: long-lived Instagram token (starts with IGAA...)
IG_USER_ID=                    # Instagram account id. Unified: optional if exactly one account is assigned
                               # to the token (found automatically); required if several. Run `npm run list-reels`.
                               # instagram_login: the `user_id` value printed by `npm run list-reels`.

# Any random string you choose; paste the same value into the webhook setup screen in Meta.
WEBHOOK_VERIFY_TOKEN=change-me-to-a-random-string

# ---- Public pages (privacy policy, data deletion, terms) shown at /privacy, /data-deletion, /terms
OWNER_NAME=                    # Your name or business name, shown on the public pages.
CONTACT_EMAIL=                 # Email people can write to (questions, data deletion requests).

# ---- Optional
# Whole campaigns JSON as text (same content as campaigns.json). If set, it is used instead of the file.
# Handy on hosts without the file, e.g. Render. Changing it needs a restart/redeploy.
CAMPAIGNS_JSON=
# Where the "already DMed" record is kept. Default: data/state.json
# STATE_FILE=
PORT=3000
# Default: v27.0 in unified mode, v23.0 in instagram_login mode
GRAPH_VERSION=
# true = log what would be sent but don't call Instagram (for testing)
DRY_RUN=false
# Delays (milliseconds) before retry 1, 2, 3 of a failed DM. Default: 30000,120000,600000
# RETRY_DELAYS_MS=30000,120000,600000
