# ---- Meta / Instagram app (developers.facebook.com -> your app -> Instagram -> API setup with Instagram login)
INSTAGRAM_APP_SECRET=          # "Instagram app secret" - used to verify webhook signatures
IG_ACCESS_TOKEN=               # Long-lived Instagram user access token (starts with IGAA...)
IG_USER_ID=                    # Use the `user_id` value printed by `npm run list-reels`

# Any random string you choose; paste the same value into the webhook setup screen in Meta.
WEBHOOK_VERIFY_TOKEN=change-me-to-a-random-string

# ---- Optional
PORT=3000
GRAPH_VERSION=v23.0
# true = log what would be sent but don't call Instagram (for testing)
DRY_RUN=false
